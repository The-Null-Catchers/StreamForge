NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
DATABASE_URL=postgres://streamforge:localdev@postgres:5432/streamforge
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
PLAYBACK_SECRET=replace-with-another-32-random-character-secret
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=streamforge
S3_ACCESS_KEY=streamforge
S3_SECRET_KEY=local-development-only
S3_FORCE_PATH_STYLE=true
TRANSCODE_CONCURRENCY=2
MAX_UPLOAD_SIZE_GB=20
MAX_VIDEO_DURATION_HOURS=6
UPLOAD_TTL_HOURS=48
PLAYBACK_TTL_SECONDS=3600
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=StreamForge <no-reply@localhost>
WEBHOOK_ALLOWED_HOSTS=

TRANSCRIPTION_PROVIDER=disabled
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_CHUNK_SECONDS=600

AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_MAX_TRANSCRIPT_CHARS=60000

LIVE_INGEST_ENABLED=true
LIVE_MEDIAMTX_API_URL=http://mediamtx:9997
LIVE_PUBLIC_RTMP_URL=rtmp://localhost:1935/live
LIVE_PUBLIC_SRT_URL=srt://localhost:8890
LIVE_PUBLIC_HLS_URL=http://localhost:8080/live
