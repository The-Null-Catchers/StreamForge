  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT or StreamForge API key"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "requestBodies": {
      "CreateVideo": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CreateVideo"
            }
          }
        }
      }
    },
    "responses": {
      "Ok": {
        "description": "Successful response",
        "content": {
          "application/json": {
            "schema": {}
          }
        }
      },
      "Error": {
        "description": "StreamForge API error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "CreateVideo": {
        "type": "object",
        "required": [
          "workspaceId",
          "title"
        ],
        "properties": {
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "privacy": {
            "type": "string",
            "enum": [
              "private",
              "unlisted",
              "public"
            ]
          }
        }
      },
      "CreateUpload": {
        "type": "object",
        "required": [
          "workspaceId",
          "videoId",
          "filename",
          "mimeType",
          "totalSize",
          "checksum"
        ],
        "properties": {
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "videoId": {
            "type": "string",
            "format": "uuid"
          },
          "filename": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "totalSize": {
            "type": "integer",
            "minimum": 1
          },
          "checksum": {
            "type": "string"
          }
        }
      },
      "ChapterInput": {
        "type": "object",
        "required": [
          "startSeconds",
          "title"
        ],
        "properties": {
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "title": {
            "type": "string"
          }
        }
      },
      "CreateLiveStream": {
        "type": "object",
        "required": [
          "workspaceId",
          "name"
        ],
        "properties": {
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "autoCreateVod": {
            "type": "boolean",
            "default": true
          },
          "dvrWindowSeconds": {
            "type": "integer",
            "minimum": 30,
            "maximum": 21600,
            "default": 600
          },
          "liveProfile": {
            "type": "string",
            "enum": [
              "source",
              "standard",
              "high"
            ],
            "default": "standard"
          }
        }
      }
    }
  }
}
