            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "summary",
                      "metadata",
                      "chapters",
                      "all"
                    ]
                  },
                  "language": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "ar",
                      "en"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
