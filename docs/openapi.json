{
  "openapi": "3.1.0",
  "info": {
    "title": "StreamForge API",
    "version": "0.1.0",
    "description": "Developer API for video uploads, processing, playback, analytics, live streaming, transcripts, AI helpers and platform integrations."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Docker stack"
    }
