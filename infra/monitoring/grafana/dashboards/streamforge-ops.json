{
  "title": "StreamForge Operations",
  "uid": "streamforge-ops",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Healthy workers",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "streamforge_worker_heartbeats",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active live streams",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "streamforge_live_streams{status=\"live\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Streams on backup",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "streamforge_live_active_ingest{ingest=\"backup\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Metrics refresh",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "streamforge_metrics_refresh_success",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue backlog",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (queue) (streamforge_queue_jobs{state=~\"waiting|delayed\"})",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue failures",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (queue) (streamforge_queue_jobs{state=\"failed\"})",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Processing jobs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "streamforge_processing_jobs",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Storage bytes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "streamforge_source_storage_bytes",
          "legendFormat": "source",
          "refId": "A"
        },
        {
          "expr": "streamforge_output_storage_bytes",
          "legendFormat": "output",
          "refId": "B"
        }
      ]
    }
  ]
}