{
  "name": "streamforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/sdk"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api": "node --import tsx apps/api/src/index.ts",
    "worker": "node --import tsx apps/worker/src/index.ts",
    "live:transcoder": "node --import tsx apps/live-transcoder/src/index.ts",
    "migrate": "node --import tsx packages/shared/src/migrate.ts",
    "typecheck": "tsc --noEmit && npm run typecheck -w apps/web",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:media": "node --import tsx --test tests/media.integration.ts",
    "test:integration": "node --import tsx --test tests/stack.integration.ts",
    "build": "tsc && npm run build -w apps/web",
    "dev": "npm run dev -w apps/web",
    "storage:init": "node --import tsx infra/scripts/init-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.0",
    "fastify": "^5.6.0",
    "ioredis": "^5.7.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.1.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "eslint": "^9.35.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
